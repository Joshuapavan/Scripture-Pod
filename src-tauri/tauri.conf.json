{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scripture Pod",
  "version": "3.1.0",
  "identifier": "com.scripturepodpro.desktop",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src": "app/src",
      "../assets/bibles": "app/assets/bibles",
      "../assets/bg": "app/assets/bg",
      "../assets/logo": "app/assets/logo",
      "../build/Logo.svg": "app/build/Logo.svg",
      "../node_modules/qrcode-generator/dist": "app/node_modules/qrcode-generator/dist"
    },
    "category": "Productivity",
    "shortDescription": "Scripture Pod presentation control application"
  }
}